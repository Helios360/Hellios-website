use Hellios-Blog

db.createCollection("users", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["email", "password", "role", "register_time"],
      properties: {
        email: {
          bsonType: "string",
          description: "must be a string and is required"
        },
        password: {
          bsonType: "string",
          description: "hashed password"
        },
        role: {
          enum: [0, 1],
          description: "0 = normal, 1 = admin"
        },
        register_time: {
          bsonType: "date"
        },
        update_time: {
          bsonType: "date"
        }
      }
    }
  }
});

db.createCollection("posts", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["slug", "title", "date"],
      properties: {
        slug: {
          bsonType: "string"
        },
        title: {
          bsonType: "string"
        },
        date: {
          bsonType: "date"
        },
        excerpt: {
          bsonType: "string"
        },
        caption: {
          bsonType: "string"
        },
        content: {
          bsonType: "string"
        }
      }
    }
  }
});

db.createCollection("articles", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["slug", "title", "date", "description", "price", "caption", "tags"],
      properties: {
        id: {
          bsonType: "int",
          description: "optional numeric article id"
        },
        slug: {
          bsonType: "string",
          description: "unique article slug"
        },
        title: {
          bsonType: "string",
          description: "article title"
        },
        date: {
          bsonType: "date",
          description: "publication date"
        },
        description: {
          bsonType: "string",
          description: "short article description"
        },
        price: {
          bsonType: ["double", "int", "long", "decimal"],
          description: "article price"
        },
        caption: {
          bsonType: "string",
          description: "image path or caption"
        },
        tags: {
          bsonType: "array",
          description: "list of article tags",
          items: {
            bsonType: "string"
          }
        }
      }
    }
  }
});





db.articles.insertOne({
  id: 1,
  slug: "iphone-15-pro-review",
  title: "iPhone 15 Pro Review",
  date: new Date(),
  description: "A quick look at Apple's latest flagship.",
  price: 999,
  caption: "/ArticleImages/iphone15pro.jpg",
  tags: ["apple", "iphone", "review"]
});

db.users.insertOne({
  email: "admin@test.com",
  password: "hashed_password_here",
  role: 1,
  register_time: new Date(),
  update_time: new Date()
});

db.posts.insertOne({
  slug: "ActivateWindows10",
  title: 'How to activate windows 10 in cmd with any key',
  date: new Date(),
  excerpt: "So, you're looking to activate Windows for free, huh? Well, you’ve come to the right place.",
  caption: "/PostImages/win10.jpg",
  content: `
So, you're looking to activate Windows for free, huh? Well, you’ve come to the right place. 
I totally get your need to keep things simple.

To activate Windows, all you need is a key (any of the ones below will work for different versions), 
and a couple of commands that will get the job done!

Here are the keys you'll need:

Home: TX9XD-98N7V-6WMQ6-BX7FG-H8Q99
Home N: 3KHY7-WNT83-DGQKR-F7HPR-844BM
Home Single Language: 7HNRX-D7KGG-3K4RQ-4WPJ4-YTDFH
Home Country Specific: PVMJN-6DFY6-9CCP6-7BKTT-D3WVR
Professional: W269N-WFGWX-YVC9B-4J6C9-T83GX
Professional N: MH37W-N47XK-V7XM9-C7227-GCQG9
Education: NW6C2-QMPVW-D7KKK-3GKT6-VCFB2
Education N: 2WH4N-8QGBV-H22JP-CT43Q-MDWWJ
Enterprise: NPPR9-FWDCX-D2C8J-H872K-2YT43
Enterprise N: DPH2V-TTNVB-4X9Q3-TJR4H-KHJW4

Open your Command Prompt as an administrator (right-click and select "Run as Administrator").

Type this command to install the key (replace "a key" with one of the keys above):

slmgr /ipk "a key"

Then, type this command to set the KMS server:

slmgr /skms kms8.msguides.com

Finally, activate Windows with the following command:

slmgr /ato

And voilà! Your Windows should be activated.
Don't forget to keep the keys in a text file so it's more practicle.

Thanks for dropping by! Hope you find this guide helpful. Until next time, stay safe, stay private, and stay open! :3
`
});